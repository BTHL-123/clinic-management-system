# ===== CẤU HÌNH FRONTEND =====
# Copy file này thành .env rồi điền giá trị phù hợp.
# File .env sẽ KHÔNG được đưa lên Git (đã có trong .gitignore).

# Google OAuth Client ID (lấy từ Google Cloud Console)
# Backend API URL. Use the deployed backend URL ending in /api in production.
VITE_API_BASE_URL=http://localhost:8080/api

# Used by real-time WebSocket clients. Keep /api so the application can derive the server origin.
VITE_API_URL=http://localhost:8080/api

VITE_GOOGLE_CLIENT_ID=
