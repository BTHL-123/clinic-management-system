# PostgreSQL container
POSTGRES_DB=clinic_management
POSTGRES_USER=clinic_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Application security and first administrator
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ALLOWED_ORIGINS=http://localhost
APP_ADMIN_EMAIL=admin@your-clinic.example
APP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
APP_ADMIN_FULL_NAME=System Administrator

# SePay
SEPAY_API_KEY=replace-with-the-new-deploy-token
SEPAY_BANK_ACCOUNT=your-bank-account-number
SEPAY_BANK_CODE=MBBank

# Optional integrations
VITE_GOOGLE_CLIENT_ID=
APP_MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
