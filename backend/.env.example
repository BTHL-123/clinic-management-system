DB_URL=jdbc:postgresql://localhost:5432/clinic_management
DB_USERNAME=postgres
DB_PASSWORD=postgres
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SERVER_PORT=8080

# Required for a clean production deployment. Flyway creates the schema from db/migration.
SPRING_PROFILES_ACTIVE=prod
FLYWAY_ENABLED=true

# Initial data for a new deployment. The seed is idempotent and does not create patients,
# appointments, payments, demo doctors, or medical records.
APP_SEED_ENABLED=true
APP_ADMIN_EMAIL=admin@your-clinic.example
APP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
APP_ADMIN_FULL_NAME=System Administrator

# Set APP_MAIL_ENABLED=true and configure SMTP to send OTP emails for real.
# For Gmail, use an App Password instead of your normal account password.
APP_MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

AVATAR_UPLOAD_DIR=uploads/avatars

# SePay payment verification and VietQR generation.
# Never commit a real token or bank account number.
SEPAY_API_KEY=your-sepay-api-token
SEPAY_BANK_ACCOUNT=your-bank-account-number
SEPAY_BANK_CODE=your-bank-code
SEPAY_TRANSACTIONS_URL=https://my.sepay.vn/userapi/transactions/list
SEPAY_WEBHOOK_REQUIRES_VERIFICATION=true

# ==========================================
# AI CONFIGURATION
# ==========================================
# AI_PROVIDER accepts: groq, gemini
AI_PROVIDER=groq

# Required if AI_PROVIDER=groq
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Required if AI_PROVIDER=gemini
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
